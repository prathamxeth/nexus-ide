# FalkorDB Graph Engine Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=nexus_code_graph

# FalkorDB Cloud / Password authentication (optional)
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
FALKORDB_SSL=false

# Cloud Deployment CORS (optional, comma-separated origins or *; *.vercel.app preview URLs are auto-allowed)
CORS_ORIGINS=http://localhost:3000,https://nexus-ide.vercel.app

# LLM Providers (BYOK - Bring Your Own Key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
